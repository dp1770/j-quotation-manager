# =====================================================================
# Local Development Environment Variables (.dev.vars)
# Copy this file to .dev.vars for local testing with `wrangler dev`
# NEVER COMMIT .dev.vars TO GIT (Already in .gitignore)
# =====================================================================

JWT_SECRET="local-development-secret-key-min-32-chars-long"

# Cloudflare Turnstile Secret Key (Use 1x0000000000000000000000000000000AA for always-pass local testing)
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
